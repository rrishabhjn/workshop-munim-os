# Copy to .env for local development. Never commit real secrets to Git.
# In production (Cloud Run), store secret values in GCP Secret Manager.

# --- App & Security ---
APP_ENV=development
APP_BASE_URL=https://your-cloud-run-url.a.run.app
ALLOWED_EMAILS=you@gmail.com,brother@gmail.com,staff@gmail.com

# --- Telegram Bot & Mini App ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-char-secret
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Optional: separate internal group chats + admin error alert ID
TELEGRAM_FLOOR_CHAT_ID=
TELEGRAM_ACCOUNTS_CHAT_ID=
TELEGRAM_MORNING_BRIEF_CHAT_ID=
ADMIN_TELEGRAM_USER_ID=

# --- Supabase (Mumbai ap-south-1 — PostgreSQL + Auth) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Gemini API (Paid Tier linked to personal GCP billing) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-4-hydrogen
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# --- Zoho Books India (zoho.in — Wave 2) ---
ZOHO_BOOKS_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- GCP Storage (asia-south1), Cloud Tasks & Nightly Backup Sheet ---
GCP_PROJECT_ID=beawar-workshop-os
GCP_REGION=asia-south1
GCS_STORAGE_BUCKET=workshop-munim-assets
CLOUD_TASKS_QUEUE=telegram-worker-queue
CRON_AUTH_SECRET=replace-with-random-secret
BACKUP_SHEET_ID=
